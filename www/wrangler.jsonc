{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lesetid",
  "compatibility_date": "2026-04-25",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "routes": [
    {
      "custom_domain": true,
      "pattern": "lesetid.dev"
    },
    {
      "custom_domain": true,
      "pattern": "examples.lesetid.dev"
    },
    {
      "custom_domain": true,
      "pattern": "www.lesetid.dev"
    }
  ]
}
