{
  "name": "@lesetid/www",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint -c ../oxlint.config.ts . && astro check",
    "clean": "git clean -xdf dist node_modules .astro",
    "typecheck": "astro-check",
    "cf-typegen": "wrangler types",
    "lint:fix": "oxlint -c ../oxlint.config.ts --fix . && astro check",
    "fmt": "oxfmt -c ../oxfmt.config.ts .",
    "fmt:check": "oxfmt -c ../oxfmt.config.ts --check .",
    "lint:astro": "astro check"
  },
  "dependencies": {
    "@iconify-json/logos": "catalog:www",
    "@iconify-json/ph": "catalog:www",
    "astro": "catalog:www",
    "lesetid": "workspace:*",
    "zod": "catalog:www"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:www",
    "@astrojs/cloudflare": "catalog:www",
    "@types/node": "catalog:types",
    "@unocss/astro": "catalog:www",
    "@unocss/reset": "catalog:www",
    "typescript": "catalog:framework",
    "unocss": "catalog:www",
    "unplugin-icons": "catalog:www",
    "wrangler": "catalog:www",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "oxlint-tsgolint": "catalog:dev"
  }
}
