{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["oxlint.config.ts", "oxfmt.config.ts", "tsconfig.json"],
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^topo", "^build"],
      "outputs": []
    },
    "lint:fix": {
      "dependsOn": ["^topo", "^build"],
      "cache": false
    },
    "lint:astro": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "fmt": {
      "cache": false
    },
    "fmt:check": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^topo", "^build"]
    },
    "//#test": {
      "dependsOn": []
    },
    "test": {
      "cache": false,
      "dependsOn": []
    }
  },
  "globalPassThroughEnv": ["NODE", "NODE_ENV", "CI"]
}
