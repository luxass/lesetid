{
  "name": "lesetid",
  "version": "2.1.1",
  "description": "A dead simple read time estimation",
  "keywords": [
    "character count",
    "characters per minute",
    "medium",
    "read",
    "read time",
    "reading time",
    "time",
    "words per minute"
  ],
  "homepage": "https://github.com/luxass/lesetid",
  "bugs": {
    "url": "https://github.com/luxass/lesetid/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Lucas Nørgård",
    "email": "lucasnrgaard@gmail.com",
    "url": "https://luxass.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxass/lesetid.git",
    "directory": "packages/lesetid"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./stream": {
      "import": "./dist/stream.mjs",
      "require": "./dist/stream.cjs"
    },
    "./utils": {
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --tsconfig=tsconfig.build.json",
    "dev": "tsdown --watch",
    "lint": "oxlint -c ../../oxlint.config.ts .",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "clean": "git clean -xdf dist node_modules",
    "lint:fix": "oxlint -c ../../oxlint.config.ts --fix .",
    "fmt": "oxfmt -c ../../oxfmt.config.ts .",
    "fmt:check": "oxfmt -c ../../oxfmt.config.ts --check ."
  },
  "devDependencies": {
    "@lesetid/tsconfig": "workspace:*",
    "@types/node": "catalog:types",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "oxlint-tsgolint": "catalog:dev",
    "publint": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "volapyk": "catalog:monorepo"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.11.2"
}
