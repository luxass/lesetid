{
  "name": "remark-lesetid",
  "version": "2.1.1",
  "description": "A remark plugin to add reading time to your markdown files",
  "keywords": [
    "read time",
    "reading time",
    "remark-plugin",
    "words per minute"
  ],
  "homepage": "https://github.com/luxass/remark-lesetid",
  "bugs": {
    "url": "https://github.com/luxass/remark-lesetid/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Lucas Nørgård",
    "email": "lucasnrgaard@gmail.com",
    "url": "https://luxass.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxass/lesetid.git",
    "directory": "packages/remark-lesetid"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./astro": {
      "import": "./dist/astro.mjs",
      "require": "./dist/astro.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --tsconfig=tsconfig.build.json",
    "dev": "tsdown --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "clean": "git clean -xdf dist node_modules"
  },
  "dependencies": {
    "lesetid": "workspace:*",
    "mdast-util-to-string": "catalog:runtime",
    "unist-util-visit": "catalog:runtime"
  },
  "devDependencies": {
    "@lesetid/tsconfig": "workspace:*",
    "@types/mdast": "catalog:types",
    "@types/node": "catalog:types",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "publint": "catalog:dev",
    "remark": "catalog:example",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "unified": "catalog:runtime",
    "vfile": "catalog:runtime",
    "volapyk": "catalog:dev"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.4.1"
}
