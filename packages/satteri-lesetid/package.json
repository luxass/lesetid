{
  "name": "satteri-lesetid",
  "version": "0.1.1",
  "description": "A Sätteri plugin that adds reading time to your Markdown files",
  "keywords": [
    "astro",
    "read time",
    "reading time",
    "satteri",
    "satteri-plugin",
    "words per minute"
  ],
  "homepage": "https://github.com/luxass/lesetid/tree/main/packages/satteri-lesetid",
  "bugs": {
    "url": "https://github.com/luxass/lesetid/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Lucas Nørgård",
    "email": "lucasnrgaard@gmail.com",
    "url": "https://luxass.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxass/lesetid.git",
    "directory": "packages/satteri-lesetid"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --tsconfig=tsconfig.build.json",
    "dev": "tsdown --watch",
    "lint": "oxlint -c ../../oxlint.config.ts .",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "clean": "git clean -xdf dist node_modules",
    "lint:fix": "oxlint -c ../../oxlint.config.ts --fix .",
    "fmt": "oxfmt -c ../../oxfmt.config.ts .",
    "fmt:check": "oxfmt -c ../../oxfmt.config.ts --check ."
  },
  "dependencies": {
    "lesetid": "workspace:*"
  },
  "devDependencies": {
    "@lesetid/tsconfig": "workspace:*",
    "@types/node": "catalog:types",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "oxlint-tsgolint": "catalog:dev",
    "publint": "catalog:dev",
    "satteri": "catalog:satteri-lesetid",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "satteri": "^0.11.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.11.2"
}
