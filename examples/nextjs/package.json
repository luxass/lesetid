{
  "name": "@lesetid-example/nextjs",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "clean": "git clean -xdf dist node_modules .next",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint -c ../../oxlint.config.ts .",
    "lint:fix": "oxlint -c ../../oxlint.config.ts --fix .",
    "fmt": "oxfmt -c ../../oxfmt.config.ts .",
    "fmt:check": "oxfmt -c ../../oxfmt.config.ts --check ."
  },
  "dependencies": {
    "classnames": "catalog:example",
    "date-fns": "catalog:example",
    "gray-matter": "catalog:example",
    "lesetid": "workspace:*",
    "next": "catalog:example",
    "react": "catalog:example",
    "react-dom": "catalog:example",
    "remark": "catalog:example",
    "remark-html": "catalog:example"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:example",
    "@types/node": "catalog:types",
    "@types/react": "catalog:example",
    "@types/react-dom": "catalog:example",
    "postcss": "catalog:example",
    "tailwindcss": "catalog:example",
    "typescript": "catalog:framework",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "oxlint-tsgolint": "catalog:dev"
  },
  "stackblitz": {
    "installDependencies": false,
    "startCommand": "node .stackblitz/cleanup.mjs && npm install && npm run dev"
  }
}
