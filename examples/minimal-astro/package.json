{
  "name": "@lesetid-example/minimal-astro",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "astro dev",
    "clean": "git clean -xdf dist node_modules .astro",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "oxlint -c ../../oxlint.config.ts . && astro check",
    "lint:fix": "oxlint -c ../../oxlint.config.ts --fix . && astro check",
    "fmt": "oxfmt -c ../../oxfmt.config.ts .",
    "fmt:check": "oxfmt -c ../../oxfmt.config.ts --check .",
    "lint:astro": "astro check"
  },
  "dependencies": {
    "@astrojs/mdx": "catalog:www",
    "@astrojs/rss": "catalog:www",
    "@astrojs/sitemap": "catalog:www",
    "astro": "catalog:www",
    "remark-lesetid": "workspace:*"
  },
  "devDependencies": {
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "oxlint-tsgolint": "catalog:dev",
    "@astrojs/check": "catalog:www",
    "typescript": "catalog:framework"
  },
  "stackblitz": {
    "installDependencies": false,
    "startCommand": "node .stackblitz/cleanup.mjs && npm install && npm run dev"
  }
}
