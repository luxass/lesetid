{
  "name": "@lesetid/tsconfig",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "lint": "oxlint --no-error-on-unmatched-pattern -c ../../oxlint.config.ts .",
    "lint:fix": "oxlint --no-error-on-unmatched-pattern -c ../../oxlint.config.ts --fix .",
    "fmt": "oxfmt -c ../../oxfmt.config.ts .",
    "fmt:check": "oxfmt -c ../../oxfmt.config.ts --check ."
  },
  "devDependencies": {
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "oxlint-tsgolint": "catalog:dev"
  },
  "files": [
    "base.json",
    "base.build.json"
  ]
}
